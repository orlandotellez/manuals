---
// Manual shell (S2, S11, S13): the manual's chapters on the left, the page in the
// middle, the titles of the page on the right.
//
// Inside a manual the left column belongs to that manual alone: its chapter list
// replaces the library tree, and the only way out is the "Todos los manuales" link
// and the breadcrumbs. The pager at the end of the page walks the chapters of this
// manual, in order, exactly like a book.
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DocsNav from '../components/DocsNav.astro';
import DocsToc from '../components/DocsToc.astro';
import {
  chapterHref,
  getChapterNeighbours,
  manualHref,
  type ManualView,
  type Page,
} from '../lib/manuals';
import '../styles/docs.css';

interface Props {
  manual: ManualView;
  page: Page;
  headings: MarkdownHeading[];
  /** Manuals in the library, for the position chip. */
  libraryTotal: number;
}

const { manual, page, headings, libraryTotal } = Astro.props;

const isChapter = page.data.kind === 'chapter';
const slug = page.data.slug;
const { previous, next } = isChapter ? getChapterNeighbours(manual, slug) : { previous: undefined, next: undefined };

const total = manual.chapters.length;
const sectionAnchor = `/docs/#${manual.section.id}`;
const coverHref = manualHref(manual.id);
const description = isChapter
  ? `${page.data.title} — capítulo de ${manual.title}, ${manual.section.title}.`
  : `${manual.title}: ${total} capítulos de ${manual.section.title}.`;
---
<BaseLayout title={`${page.data.title} · ${manual.title} · Manuales`} description={description} wide>
  <Fragment slot="head">
    <meta data-pagefind-meta="section[content]" content={manual.section.title} />
    <meta data-pagefind-meta="manual[content]" content={manual.title} />
  </Fragment>

  <div class="docs">
    <aside class="docs__sidebar">
      <DocsNav manual={manual} currentSlug={isChapter ? slug : undefined} />
    </aside>

    {
      /*
       * Search indexing: the page body is the only part of the page that belongs
       * in the index, so `data-pagefind-body` marks it and the chrome around the
       * prose is ignored.
       */
    }
    <article class="docs__article" data-pagefind-body>
      <details class="docs-menu" data-pagefind-ignore>
        <summary class="docs-menu__summary">Capítulos del manual</summary>
        <div class="docs-menu__body">
          <DocsNav
            manual={manual}
            currentSlug={isChapter ? slug : undefined}
            label="Capítulos del manual (móvil)"
          />
        </div>
      </details>

      {
        headings.some((heading) => heading.depth === 2 || heading.depth === 3) && (
          <details class="docs-menu docs-toc-menu" data-pagefind-ignore>
            <summary class="docs-menu__summary">En esta página</summary>
            <div class="docs-menu__body">
              <DocsToc headings={headings} compact />
            </div>
          </details>
        )
      }

      <nav class="breadcrumbs" aria-label="Ruta de navegación" data-pagefind-ignore>
        <ol class="breadcrumbs__list">
          <li class="breadcrumbs__item"><a class="breadcrumbs__link" href="/">Inicio</a></li>
          <li class="breadcrumbs__item"><a class="breadcrumbs__link" href="/docs/">Manuales</a></li>
          <li class="breadcrumbs__item breadcrumbs__item--context">
            <a class="breadcrumbs__link" href={sectionAnchor}>{manual.section.title}</a>
          </li>
          <li class="breadcrumbs__item breadcrumbs__item--context">
            <a class="breadcrumbs__link" href={coverHref} aria-current={isChapter ? undefined : 'page'}>
              {manual.title}
            </a>
          </li>
          {isChapter && <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">{page.data.title}</li>}
        </ol>
      </nav>

      <header class="docs__header">
        <p class="docs__eyebrow" data-pagefind-ignore>{manual.section.title}</p>
        <h1 class="docs__title" data-pagefind-meta="title">{page.data.title}</h1>
        <div class="docs__meta" data-pagefind-ignore>
          <span class="chip">Manual {manual.position} de {libraryTotal}</span>
          <span class="chip">
            {isChapter ? `Capítulo ${page.data.order} de ${total}` : `${total} capítulos`}
          </span>
        </div>
      </header>

      {
        /* A cover with no preamble would leave an empty column of nothing. */
        (page.body ?? '').trim().length > 0 && (
          <div class="prose">
            <slot />
          </div>
        )
      }

      {/* Content of a page that is not part of the prose (the cover's chapter list). */}
      <slot name="after" />

      {
        isChapter && (previous || next) && (
          <nav class="pager" aria-label="Capítulos del manual" data-pagefind-ignore>
            {previous && (
              <a class="pager__link pager__link--previous" href={chapterHref(manual.id, previous.data.slug)} rel="prev">
                <span class="pager__direction">Anterior</span>
                <span class="pager__title">{previous.data.title}</span>
              </a>
            )}
            {next && (
              <a class="pager__link pager__link--next" href={chapterHref(manual.id, next.data.slug)} rel="next">
                <span class="pager__direction">Siguiente</span>
                <span class="pager__title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    <aside class="docs__toc">
      <DocsToc headings={headings} />
    </aside>
  </div>
</BaseLayout>

{
  /*
   * Copy control for code blocks. The block, its language label and the button
   * are server-rendered; this only wires the click, so the page is complete and
   * readable without it.
   */
}
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.code-block__copy');

  for (const button of buttons) {
    button.addEventListener('click', async () => {
      const code = button.closest('.code-block')?.querySelector('pre');
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.textContent = 'Copiado';
        button.dataset.copied = 'true';
      } catch {
        button.textContent = 'No se pudo copiar';
      }

      window.setTimeout(() => {
        button.textContent = 'Copiar';
        delete button.dataset.copied;
      }, 1800);
    });
  }
</script>
