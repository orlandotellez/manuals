---
// The left column of a manual: its chapters, one page each (S11, S13).
//
// Entering a manual replaces the library tree with that manual's chapters, so the
// column reads like the table of contents of a book instead of a menu of other
// books. The way back to the library is one link at the top, the same one the
// breadcrumbs offer.
import { chapterHref, manualHref, type ManualView } from '../lib/manuals';

interface Props {
  manual: ManualView;
  /** Chapter being read; empty on the manual's cover. */
  currentSlug?: string;
  /** Announced to assistive technology; the mobile copy names itself. */
  label?: string;
}

const { manual, currentSlug, label = 'Capítulos del manual' } = Astro.props;
---
<nav class="docs-nav" aria-label={label}>
  <a class="docs-nav__back" href="/docs/">Todos los manuales</a>
  <p class="docs-nav__section-title">{manual.section.title}</p>
  <a
    class="docs-nav__manual"
    href={manualHref(manual.id)}
    aria-current={currentSlug ? undefined : 'page'}
  >
    {manual.title}
  </a>
  <ol class="docs-nav__chapters">
    {
      manual.chapters.map((chapter) => (
        <li>
          <a
            class="docs-nav__chapter"
            href={chapterHref(manual.id, chapter.data.slug)}
            aria-current={chapter.data.slug === currentSlug ? 'page' : undefined}
          >
            {chapter.data.title}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
