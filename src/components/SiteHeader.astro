---
// Sticky top bar: brand and destination links on the left, search and theme
// toggle on the right. Only routes that exist are linked (S2).
import SiteSearch from './SiteSearch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Pages in the library, for the search placeholder. */
  count: number;
  /** Docs pages run full viewport width so the rail and the brand line up. */
  wide?: boolean;
}

const { count, wide = false } = Astro.props;
const path = Astro.url.pathname;
const inDocs = path.startsWith('/docs');
---
<header class="site-header">
  <div class:list={['container', 'site-header__inner', wide && 'container--wide']}>
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__name">Manuales</span>
    </a>
    <nav class="site-header__nav" aria-label="Principal">
      <a class="site-header__link site-header__link--home" href="/" aria-current={path === '/' ? 'page' : undefined}>
        Inicio
      </a>
      <a class="site-header__link" href="/docs/" aria-current={inDocs ? 'page' : undefined}>
        Manuales
      </a>
      <SiteSearch count={count} />
      <ThemeToggle />
    </nav>
  </div>
</header>
