---
// Home page (S4): what the library is, then the manuals section itself, grouped
// by section and readable in one screen and a half.
//
// Every number on this page is counted from the registry, never typed, so it
// cannot drift from the content.
import BaseLayout from '../layouts/BaseLayout.astro';
import TechLogo from '../components/TechLogo.astro';
import { getLibrarySize, getManuals, groupManuals, manualHref } from '../lib/manuals';
import '../styles/landing.css';

const manuals = await getManuals();
const groups = groupManuals(manuals);
const size = getLibrarySize(manuals);
---
<BaseLayout
  title="Manuales · manuales técnicos de desarrollo"
  description={`${size.manuals} manuales técnicos de desarrollo en ${size.sections} secciones, ${size.chapters} capítulos en total.`}
>
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Manuales</p>
      <h1 class="hero__title">Manuales técnicos de desarrollo</h1>
      <p class="hero__lead">
        Mis manuales de desarrollo: el backend, las bases de datos, las aplicaciones móviles y las
        redes. Cada manual está partido en capítulos, uno por página: el índice del manual queda a
        la izquierda, los títulos de la página a la derecha y al final de cada capítulo tenés el
        anterior y el siguiente.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#tecnologias">Ver las tecnologías</a>
        <a
          class="btn btn--ghost"
          href="https://github.com/orlandotellez/manuals"
          target="_blank"
          rel="noopener noreferrer me"
        >Repositorio<span class="sr-only"> (se abre en una pestaña nueva)</span></a
        >
      </div>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">{size.manuals}</span>
          <span class="hero__stat-label">manuales</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{size.chapters}</span>
          <span class="hero__stat-label">capítulos</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">{size.sections}</span>
          <span class="hero__stat-label">secciones temáticas</span>
        </div>
      </div>
    </div>
  </section>

  <section class="library" id="tecnologias">
    <div class="container">
      <header class="library__header">
        <h2 class="library__title">Tecnologías</h2>
        <p class="library__note">
          {size.sections} tecnologías, {size.manuals} manuales y {size.chapters} capítulos. Elegí una
          para ver sus manuales en el índice completo.
        </p>
      </header>

      <div class="tech-grid">
        {
          groups.map((group) => (
            <a class="tech-card" href={`/docs/#${group.section.id}`}>
              <TechLogo logo={group.section.logo} />
              <span class="tech-card__title">{group.section.title}</span>
              <span class="tech-card__count">
                {group.manuals.length} {group.manuals.length === 1 ? 'manual' : 'manuales'}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
